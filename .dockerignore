# Keep the build context small and, more importantly, keep secrets and host-specific
# artefacts out of the image entirely.

# Never copy real credentials into a layer.
.env
.env.local
.env.*.local

node_modules
.next
out
build
dist

# Host storage: uploaded label images and generated PDFs belong on a mounted volume,
# not baked into the image.
storage

.git
.gitignore
.github

# Tests run in CI and locally, never inside the runtime image.
*.test.ts
*.test.tsx

# Build caches and editor state.
*.tsbuildinfo
.eslintcache
coverage
.vscode
.idea
.DS_Store
Thumbs.db

# Database dumps.
*-backup.sql
dump.sql

# Local-only tooling that has no role inside the container.
docker-compose.yml
