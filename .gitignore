# dependencies
node_modules/
.pnp
.pnp.js

# next.js
.next/
/out/
next-env.d.ts
*.tsbuildinfo

# production
#
# Anchored with a leading slash. Without one, git matches the pattern at *any* depth —
# so a bare `build/` would also ignore `src/anything/build/`. That is not hypothetical:
# an unanchored `storage/` below silently excluded the whole of `src/lib/storage/` from
# this repository, and the omission only surfaced as a webpack "can't resolve
# @/lib/storage" when building from a fresh clone.
/build/
/dist/

# environment
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# local object storage fallback (uploaded label images + generated PDFs).
# Anchored: `src/lib/storage/` is source code and must stay tracked.
/storage/

# database dumps — contain real inspection records and password hashes.
# Note the leading path anchors: prisma/migrations/**/*.sql must stay tracked.
/lm-backup.sql
/*-backup.sql
/dump.sql

# prisma
prisma/*.db
prisma/*.db-journal

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# misc
/coverage/
.eslintcache
