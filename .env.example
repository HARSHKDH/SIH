# ---------------------------------------------------------------------------
# Legal Metrology Packaged Commodities Compliance Checker — environment
# Copy to `.env` and fill in. Only DATABASE_URL, REDIS_URL and JWT_SECRET are
# strictly required to boot; everything else has a safe local fallback.
# ---------------------------------------------------------------------------

# --- Database (PostgreSQL) -------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/legal_metrology?schema=public"

# --- Queue (Redis / BullMQ) ------------------------------------------------
REDIS_URL="redis://localhost:6379"

# --- Auth ------------------------------------------------------------------
# Must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
JWT_EXPIRES_IN="8h"

# --- Vision extraction -----------------------------------------------------
# THIS IS THE ONLY API KEY THE PROJECT NEEDS.
# Free key, no credit card: https://aistudio.google.com/apikey
#
# Leave it blank and the app still runs end to end using a deterministic offline
# extractor — the queue, rule engine, scoring and PDF report all execute normally
# and the UI states clearly that it is in fallback mode.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash"
GEMINI_FALLBACK_MODELS="gemini-3.5-flash-lite,gemini-3.8-flash"
# A truncated response is invalid JSON rather than a shorter answer, so this is set
# with headroom. Billing is on tokens actually produced, not on the ceiling.
GEMINI_MAX_OUTPUT_TOKENS="8192"

# Provider selection. "auto" (default) picks Gemini if GEMINI_API_KEY is set,
# then Claude if ANTHROPIC_API_KEY is set, then the offline extractor.
# Force one with "gemini", "claude" or "mock".
EXTRACTION_PROVIDER="auto"

# Optional alternative provider — only needed if you set EXTRACTION_PROVIDER=claude.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"
ANTHROPIC_MAX_TOKENS="2048"

# --- Storage ---------------------------------------------------------------
# "local" writes to LOCAL_STORAGE_PATH and serves through /api/files/*.
# "s3" uses presigned PUT URLs against the bucket below.
STORAGE_DRIVER="local"
LOCAL_STORAGE_PATH="./storage"

AWS_REGION="ap-south-1"
AWS_S3_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# Optional: set for S3-compatible services (MinIO, R2, etc.)
AWS_S3_ENDPOINT=""
AWS_S3_FORCE_PATH_STYLE="false"

# --- App -------------------------------------------------------------------
APP_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Legal Metrology Compliance Checker"

# --- Worker ----------------------------------------------------------------
WORKER_CONCURRENCY="3"
SCAN_JOB_ATTEMPTS="3"

# --- Puppeteer -------------------------------------------------------------
# Only needed if you want to point at a system Chrome instead of the bundled one.
PUPPETEER_EXECUTABLE_PATH=""
